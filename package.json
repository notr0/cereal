{
  "name": "cereal",
  "productName": "Cereal",
  "version": "0.1.0",
  "private": true,
  "description": "Cereal: local-first AI meeting notes that run on your own models",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "predev": "node scripts/copy-ort.mjs",
    "prebuild": "node scripts/copy-ort.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder --win --dir",
    "icon": "node scripts/make-icon.mjs",
    "shortcuts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/shortcuts.ps1"
  },
  "build": {
    "appId": "local.cereal.app",
    "productName": "Cereal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.136.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.60.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
